# Required explicit opt-in for anonymous synthetic CRM data.
CRM_MODE=demo
DEMO_MODE=true

# Paths are resolved from the process working directory unless absolute.
CRM_DATABASE_PATH=./data/sales-crm.sqlite

# HTTP defaults. Keep demo connections to loopback unless using a temporary tunnel.
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authenticated mode (Keycloak resource server); do not set these for demo mode.
# CRM_MODE=authenticated
# DEMO_MODE=false
# OAUTH_ISSUER=https://identity.example.com/realms/sales
# OAUTH_AUDIENCE=https://crm.example.com
# OAUTH_JWKS_URL=https://identity.example.com/realms/sales/protocol/openid-connect/certs
# OAUTH_RESOURCE=https://crm.example.com
# OAUTH_AUTHORIZATION_SERVER=https://identity.example.com/realms/sales
# AUTH_READ_SCOPE=crm:read
# AUTH_WRITE_SCOPE=crm:write